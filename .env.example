# ── Mock vs Real API ──────────────────────────────────────────────────────────
# App calls the real backend by default — no change needed.
# Set VITE_USE_MOCK=true to use in-memory mock data (no backend required).
VITE_USE_MOCK=false

# ── Backend URL ───────────────────────────────────────────────────────────────
# Set this to your backend's base URL — the Vite dev-server proxies all /api/* requests here.
# Example: VITE_API_URL=http://localhost:3001
# VITE_API_URL=http://localhost:3000

